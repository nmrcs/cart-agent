{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// The base emits declarations for packages; an app only type-checks.
		"noEmit": true,
		"declaration": false
	},
	"include": ["src", "vite.config.ts"]
}
