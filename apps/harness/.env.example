PORT=3002
# The harness is called by the backend only, never by the browser.
BACKEND_URL=http://localhost:3001
# Any OpenAI-compatible endpoint. LM Studio runs the model on this machine.
LLM_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
# Hosted endpoints need a key, LM Studio does not. For OpenRouter:
#   LLM_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=<model id from openrouter.ai/models>
#   LLM_API_KEY=<your key>
LLM_API_KEY=
# Keeps qwen3.5 from reasoning away its token budget. Leave empty for models
# that reject the parameter.
LLM_REASONING_EFFORT=none
